<script type="text/javascript"><!--
$(document).on('click', '[data-mcp-lang]', function (e) {
  e.preventDefault();
  document.cookie = 'mcp_lang=' + $(this).data('mcp-lang') + '; path=/; max-age=31536000; SameSite=Lax';
  location.reload();
});
$('#mcp-license-save').on('click', function () {
  var $b = $(this).prop('disabled', true), $e = $('#mcp-license-error').text('');
  $.ajax({ url: '{{ license_url|raw }}'.replace(/&amp;/g, '&'), type: 'post', data: { key: $('#mcp-license-key').val() }, dataType: 'json',
    success: function (j) { if (j.success) { location.reload(); } else { $e.text(j.error || 'Error').show(); $b.prop('disabled', false); } },
    error: function () { $e.text('Error').show(); $b.prop('disabled', false); } });
});
//--></script>

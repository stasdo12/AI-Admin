{{ header }}{{ column_left }}
{# Generated from packages/shared/admin/mcp_server.twig by build/gen_admin.py - edit the source, not this file. #}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
{% if licensed %}<button type="submit" form="form-module" aria-label="{{ ui_save|e('html_attr') }}" class="btn btn-primary"><i class="fa fa-save"></i></button>{% endif %}
        <a href="{{ cancel }}" aria-label="{{ ui_back|e('html_attr') }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{% if free %}<span class="mcp-brand" role="img" aria-label="AI Admin"></span>{% endif %}<b class="mcp-h1-brand">AI Admin</b> <span class="mcp-h1-sub">{{ ui_heading_sub }}</span></h1>
      <ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ul>
    </div>
  </div>
  <div class="container-fluid mcp-ui{% if free %} mcp-free{% endif %}">
{% if not licensed %}
    <section class="mcp-license" id="mcp-license">
      <div class="mcp-license-card">
        <div style="display:flex;justify-content:space-between;align-items:flex-start"><div class="mcp-license-ic"><i class="fa fa-key"></i></div><span class="mcp-langs" role="group" aria-label="{{ ui_language|e('html_attr') }}"><a href="#" data-mcp-lang="uk-ua" class="{% if module_lang == 'uk-ua' %}on{% endif %}">UK</a><a href="#" data-mcp-lang="en-gb" class="{% if module_lang == 'en-gb' %}on{% endif %}">EN</a></span></div>
        <h3>{{ ui_license_title }}</h3>
        <label for="mcp-license-key" class="lbl">{{ ui_license_key }}</label>
        <textarea id="mcp-license-key" class="form-control mono" rows="4" placeholder="{% if not free %}OCMCP2.…{% endif %}" spellcheck="false" autocomplete="off"></textarea>
        {% if license_reason and license_info %}<div class="mcp-err" style="display:block">{{ license_reason|replace({'%s': license_domain}) }}</div>{% endif %}
        {% if not crypto_ok %}<div class="mcp-err" style="display:block">{{ ui_license_no_crypto }}</div>{% endif %}
        <div class="mcp-err" id="mcp-license-error"></div>
        <button type="button" class="mcp-btn p" id="mcp-license-save"><i class="fa fa-check"></i> {{ ui_license_activate }}</button>
      </div>
    </section>
{% else %}
    {% if error_warning %}<div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-triangle"></i> {{ error_warning }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>{% endif %}
    {% if error_acl %}<div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-triangle"></i> {{ error_acl }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>{% endif %}
    {% if success %}<div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>{% endif %}
    <form action="{{ action }}" method="post" id="form-module" enctype="multipart/form-data">
      <input type="hidden" name="module_mcp_server_acl_json" id="input-acl-json" value=""/>
      <input type="hidden" name="module_mcp_server_rev" id="input-rev" value="{{ module_mcp_server_rev }}"/>
      <input type="hidden" name="module_mcp_server_acl_custom_json" id="input-acl-custom-json" value=""/>
      <span class="mcp-langs" role="group" aria-label="{{ ui_language|e('html_attr') }}"><a href="#" data-mcp-lang="uk-ua" class="{% if module_lang == 'uk-ua' %}on{% endif %}">UK</a><a href="#" data-mcp-lang="en-gb" class="{% if module_lang == 'en-gb' %}on{% endif %}">EN</a></span>
      <nav class="mcp-tabs" id="mcp-main-tabs">
        <a href="#tab-overview" class="active"><i class="fa fa-tachometer"></i> {{ ui_tab_overview }}</a>
        <a href="#tab-access"><i class="fa fa-shield"></i> {{ ui_tab_access }}</a>
        <a href="#tab-connections"><i class="fa fa-plug"></i> {{ ui_tab_connections }}</a>
        <a href="#tab-history"><i class="fa fa-history"></i> {{ ui_tab_history }}</a>
        <a href="#tab-prompts"><i class="fa fa-magic"></i> {{ ui_tab_prompts }}</a>
        <a href="#tab-general"><i class="fa fa-sliders"></i> {{ ui_tab_settings }}</a>
      </nav>
{% if support_tg %}      <a class="mcp-support" href="{{ support_tg }}" target="_blank" rel="noopener noreferrer"><i class="fa fa-paper-plane"></i> {{ ui_support }}</a>{% endif %}


      {# ================================================================ overview #}
      <div class="mcp-pane active" id="tab-overview">
        <section class="mcp-status{% if module_mcp_server_status %} on{% endif %}" id="ov-status">
          <div class="st-head">
            <label class="mcp-switch lg"><input type="hidden" name="module_mcp_server_status" value="0"/><input type="checkbox" name="module_mcp_server_status" value="1" id="input-status" aria-label="{{ ui_status_toggle|e('html_attr') }}"{% if module_mcp_server_status %} checked{% endif %}/><i></i></label>
            <div class="st-text">
              <h3><span class="st-on">{{ ui_status_on }}</span><span class="st-off">{{ ui_status_off }}</span></h3>
              <p><span class="st-on">{{ ui_status_on_sub }}</span><span class="st-off">{{ ui_status_off_sub }}</span></p>
            </div>
          </div>
          <div class="st-url">
            <label for="mcp-endpoint">{{ ui_mcp_address }}</label>
            <div class="mcp-row">
              <input type="text" value="{{ mcp_url }}" class="form-control mono" readonly id="mcp-endpoint" data-base="{{ mcp_base|e('html_attr') }}"/>
              <input type="hidden" name="module_mcp_server_path" id="input-path" value="{{ module_mcp_server_path|e('html_attr') }}"/>
              <button type="button" class="mcp-btn" data-mcp-copy="#mcp-endpoint"><i class="fa fa-copy"></i> {{ ui_copy }}</button>
            </div>
            <div class="mcp-help">{{ help_mcp_address_overview }}</div>
          </div>
          <ul class="mcp-checks">
            <li class="{% if https %}ok{% else %}off{% endif %}"><i class="fa fa-circle"></i><b>HTTPS</b><span>{% if https %}{{ ui_check_https_ok }}{% else %}{{ ui_check_https_bad }}{% endif %}</span></li>
            <li class="ok"><i class="fa fa-circle"></i><b>{{ ui_check_short }}</b><span>{% if pretty_urls %}{{ ui_check_short_ok }}{% else %}{{ ui_check_short_bad }}{% endif %}</span></li>
            <li class="{% if ai_connected %}ok{% else %}off{% endif %}"><i class="fa fa-circle"></i><b>{{ ui_check_signin }}</b><span>{% if ai_connected %}{{ ui_check_signin_ok }}{% else %}{{ ui_check_signin_bad }}{% endif %}</span></li>
            <li id="ov-check-access"><i class="fa fa-circle"></i><b>{{ ui_check_access }}</b><span></span></li>
          </ul>
          <div class="mcp-note w" id="ov-addr-problem" style="display:none"><i class="fa fa-exclamation-triangle"></i><span><b>{{ ui_address_problem }}.</b> <span class="t"></span></span></div>
        </section>

        <div class="mcp-kpis" id="ov-kpis"></div>

        <div class="mcp-cols2">
          <section class="mcp-card">
            <div class="mcp-card-hd"><h4>{{ ui_activity_title }}</h4><a href="#tab-history" class="mcp-link" data-goto="#tab-history">{{ ui_open_history }} <i class="fa fa-chevron-right"></i></a></div>
            <div class="mcp-bars" id="ov-chart"></div>
            <div class="mcp-legend-mini"><span><i class="sw calls"></i>{{ ui_chart_calls }}</span><span><i class="sw prob"></i>{{ ui_chart_problems }}</span></div>
            <div class="mcp-toplist" id="ov-top"></div>
          </section>
          <section class="mcp-card">
            <div class="mcp-card-hd"><h4>{{ ui_allowed_title }}</h4><a href="#tab-access" class="mcp-link" data-goto="#tab-access">{{ ui_change_access }} <i class="fa fa-chevron-right"></i></a></div>
            <div class="mcp-seclist" id="ov-access"></div>
          </section>
        </div>


        <section class="mcp-card">
          <div class="mcp-card-hd"><h4>{{ ui_recent_title }}</h4><a href="#tab-history" class="mcp-link" data-goto="#tab-history">{{ ui_all_changes }} <i class="fa fa-chevron-right"></i></a></div>
          <div id="ov-changes"><div class="mcp-empty">…</div></div>
        </section>
      </div>

      {# ================================================================ access #}
      <div class="mcp-pane" id="tab-access">
        <section class="mcp-card">
          <h4>{{ ui_access_title }}</h4>
          <p class="mcp-sub acc-sub">{{ ui_access_sub }}</p>
          <div class="mcp-toolbar">
            <span class="mcp-presets"><span class="lbl">{{ ui_quick_choice }}</span>
              <button type="button" class="mcp-btn" data-acl-preset="read">{{ text_preset_read }}</button>
              <button type="button" class="mcp-btn" data-acl-preset="write">{{ text_preset_write }}</button>
              <button type="button" class="mcp-btn" data-acl-preset="all">{{ text_preset_all }}</button>
            <button type="button" class="mcp-btn" id="acl-custom" disabled>{{ text_preset_custom }}</button>
            <button type="button" class="mcp-btn" data-acl-preset="none"><i class="fa fa-lock"></i> {{ text_preset_none }}</button></span>
          </div>
          <details class="acc-help"><summary><span class="hs"><i class="fa fa-info-circle"></i> {{ ui_levels_title }}</span><i class="fa fa-chevron-down chev"></i></summary><div class="in">
            <p class="mcp-sub">{{ ui_help_intro }}</p>
            <div class="hp-top">
              <div class="hp-box hp-levels"><b class="hp-h">{{ ui_help_levels }}</b><table>
                {% for lv in ['read', 'write', 'full', 'custom', 'none'] %}
                <tr><th><span class="mcp-dot lv-{{ lv }}"></span>{% if lv == 'custom' %}{{ ui_level_custom }}{% else %}{{ attribute(_context, 'text_level_' ~ lv) }}{% endif %}</th><td>{{ attribute(_context, 'ui_help_lv_' ~ lv) }}</td></tr>
                {% endfor %}
              </table></div>
              <div class="hp-box hp-del"><div class="hp-del-h"><i class="fa fa-trash"></i><b>{{ ui_help_del_title }}</b></div><p>{{ ui_help_del_lead }}</p><ul><li>{{ ui_help_del_ex1 }}</li><li>{{ ui_help_del_ex2 }}</li></ul><p class="ed"><i class="fa fa-exclamation-circle"></i><span>{{ ui_help_del_edit }}</span></p></div>
            </div>
            <div class="hp-dict"><i class="fa fa-database"></i><div><b>{{ ui_help_dict_title }}</b><span>{{ ui_help_dict }}</span></div></div>
            <b class="hp-h hp-mh">{{ ui_help_marks }}</b>
            <div class="hp-box hp-marks"><table>
              <tr><th><span class="am-req">*</span> {{ ui_help_mark_req_t }}</th><td>{{ ui_help_mark_req }}</td></tr>
              <tr><th><span class="mcp-badge pii">{{ text_badge_personal }}</span></th><td>{{ ui_help_mark_pii }}</td></tr>
              <tr><th><span class="mcp-badge money">{{ text_badge_money }}</span></th><td>{{ ui_help_mark_money }}</td></tr>
              <tr><th><span class="mcp-badge sec">{{ text_badge_masked }}</span></th><td>{{ ui_help_mark_masked }}</td></tr>
              <tr><th><span class="mcp-badge tech">{{ text_badge_no_edit }}</span></th><td>{{ ui_help_mark_no_edit }}</td></tr>
            </table></div>
            <p class="hp-foot">{{ ui_help_foot }}</p>
          </div></details>
        </section>
        <div class="acc-navrow">{# the sections and the search in one row, the search on the right #}
          <nav class="mcp-tabs mcp-sectabs" id="acc-sections"></nav>
              <div class="mcp-search acc-search"><i class="fa fa-search"></i><input type="text" id="acc-search" class="form-control" placeholder="{{ text_access_search }}"/></div>
        </div>
        <div id="acc-locked-note" class="mcp-note w" style="display:none"><i class="fa fa-lock"></i><span>{{ text_section_locked_note }}</span></div>
        <div class="mcp-acclist" id="acc-body"></div>
      </div>

      {# ================================================================ connections #}
      <div class="mcp-pane" id="tab-connections">
        <section class="mcp-card">
          <div class="mcp-card-hd"><h4>{{ ui_connected_title }}</h4>{% if active_connections %}<button type="button" class="mcp-btn s d mcp-revoke" data-all="1"><i class="fa fa-ban"></i> {{ text_revoke_all }}</button>{% endif %}</div>
          <p class="mcp-sub">{{ text_connections_intro }}</p>
          {% if connections|length %}
          <div class="mcp-conns">
            {% set shown = 0 %}
            {% for c in connections %}
            {% if c.status == 'active' %}{% set shown = shown + 1 %}{% endif %}
            <div class="mcp-conn{% if c.status != 'active' %} dim inactive{% elseif shown > 10 %} more{% endif %}">
              <div class="who"><b class="cn-name" data-conn="{{ c.conn|e('html_attr') }}" data-app="{{ c.client_name|e('html_attr') }}">{{ (c.label ?: c.client_name)|escape }}</b><button type="button" class="cn-rename" data-conn="{{ c.conn|e('html_attr') }}" aria-label="{{ ui_conn_rename|e('html_attr') }}"><i class="fa fa-pencil"></i></button><span class="cn-sub"><span class="cn-app"{% if not c.label %} hidden{% endif %}>{{ c.client_name|escape }} · </span>{{ c.username|escape }} · {{ c.ip|escape }} · {{ c.date_added|slice(0, 16) }}</span></div>
              {% if c.status == 'active' %}
              <div class="when"><span>{{ ui_conn_last }}</span><b>{{ c.last_used ? c.last_used|slice(0, 16) : '—' }}</b></div>
              <div class="when"><span>{{ ui_conn_expires }}</span><b>{% if c.unlimited %}{{ ui_conn_forever }}{% else %}{{ c.expires|slice(0, 16) }}{% endif %}</b></div>
              <button type="button" class="mcp-btn s d mcp-revoke" data-token-id="{{ c.token_id }}">{{ text_revoke }}</button>
              {% else %}
              <div class="when"><span>{{ c.status == 'expired' ? text_expired : text_revoked }}</span><b>{{ c.expires|slice(0, 16) }}</b></div>
              {% endif %}
            </div>
            {% endfor %}
          </div>
          {% if not active_connections %}<div class="mcp-empty" style="padding:14px">{{ ui_no_active }}</div>{% endif %}
          <div class="mcp-conns-more">
          {% if active_connections > 10 %}<button type="button" class="mcp-btn s" id="mcp-show-more">{{ ui_show_more|replace({'%d': active_connections - 10}) }}</button>{% endif %}
          {% if inactive_connections %}<button type="button" class="mcp-btn s ghost" id="mcp-toggle-inactive" data-show="{{ ui_show_inactive|replace({'%d': inactive_connections})|e('html_attr') }}" data-hide="{{ ui_hide_inactive|e('html_attr') }}">{{ ui_show_inactive|replace({'%d': inactive_connections}) }}</button>{% endif %}
          </div>
          {% else %}
          <div class="mcp-empty"><i class="fa fa-plug"></i>{{ text_no_connections }} <a href="#mcp-connect-card" data-scroll="#mcp-connect-card">{{ ui_connect_first }}</a></div>
          {% endif %}
        </section>

        <section class="mcp-card" id="mcp-connect-card">
          <h4>{{ ui_connect_title }}</h4>
          <p class="mcp-sub">{{ ui_connect_sub }}</p>
          {% if not https %}<div class="mcp-note w"><i class="fa fa-exclamation-triangle"></i><span>{{ text_https_warning }}</span></div>{% endif %}
          <div class="mcp-clients">
            {% for client in connect_clients %}
            <div class="mcp-client">
              <div class="hd"><div class="mcp-logo {{ client.id }}">{{ client.name|first }}</div><div><b>{{ client.name }}</b><span>{{ attribute(_context, 'text_client_' ~ client.id ~ '_sub') }}</span></div></div>
              <button type="button" class="mcp-btn p mcp-connect" data-url="{{ client.url }}"{% if not client.prefilled %} data-copy="{{ mcp_url }}"{% endif %}><i class="fa fa-external-link"></i> {{ ui_connect_button }}</button>
              <details class="steps"><summary>{{ ui_how_to_connect }}</summary><div><div class="mcp-paste"><button type="button" class="mcp-btn s" data-copy-text="{{ connector_name|e('html_attr') }}"><i class="fa fa-copy"></i> {{ ui_copy_name }}</button><button type="button" class="mcp-btn s" data-copy-text="{{ mcp_url }}"><i class="fa fa-copy"></i> {{ ui_copy_url }}</button></div>{{ client.steps|replace({'%s': mcp_url, '%name%': connector_name|e})|raw }}</div></details>
            </div>
            {% endfor %}
          </div>
        </section>
        <section class="mcp-card mcp-fold">
          <details id="mcp-keys"{% if error_token or error_url_secret or error_path %} open{% endif %}>{# folded by default; a save error inside opens it #}
            <summary><i class="fa fa-chevron-right mcp-chev"></i><h4>{{ ui_advanced_title }}</h4></summary>
            <div class="in">
            <input type="hidden" name="module_mcp_server_oauth" value="{{ module_mcp_server_oauth ? 1 : 0 }}"/>{# sign-in for Claude / ChatGPT stays as it is: the switch is no longer shown #}
            <div class="mcp-field">
              <label for="mcp-endpoint-conn">{{ ui_mcp_address }}</label>
              <div>
                <div class="mcp-row mcp-keyrow mcp-addrrow">
                  <input type="text" value="{{ mcp_url }}" class="form-control mono" readonly id="mcp-endpoint-conn"/>
                  {% if pretty_urls %}<button type="button" class="mcp-btn" id="mcp-path-gen"><i class="fa fa-refresh"></i> {{ text_generate }}</button>{% endif %}
                  <button type="button" class="mcp-btn" data-mcp-copy="#mcp-endpoint-conn"><i class="fa fa-copy"></i> {{ ui_copy }}</button>
                </div>
                <div class="mcp-note w" id="mcp-path-note" style="display:none;margin:8px 0 0"><i class="fa fa-exclamation-triangle"></i><span>{{ ui_address_new_note }}</span></div>
                  {% if error_path %}<div class="mcp-err" style="display:block">{{ error_path }}</div>{% endif %}
                  </div>
            </div>
            <div class="mcp-field">
              <label for="input-token">{{ entry_token }}</label>
              <div>
                <div class="mcp-row mcp-keyrow">
                  <input type="password" name="module_mcp_server_token" value="" id="input-token" class="form-control mono" autocomplete="new-password" placeholder="{% if token_set %}{{ text_token_set_placeholder }}{% endif %}"/><input type="hidden" name="module_mcp_server_token_clear" id="input-token-clear" value="0"/>
                  <button type="button" class="mcp-btn" data-mcp-toggle="#input-token" id="mcp-token-show" aria-label="{{ ui_show|e('html_attr') }}" disabled><i class="fa fa-eye"></i></button>
                  <button type="button" class="mcp-btn" data-mcp-generate="#input-token" data-mcp-length="24"><i class="fa fa-refresh"></i> {{ text_generate }}</button>
                  <button type="button" class="mcp-btn" id="mcp-token-copy" disabled><i class="fa fa-copy"></i> {{ ui_copy }}</button>
                  <button type="button" class="mcp-btn d" id="mcp-token-clear"{% if not token_set %} disabled{% endif %}><i class="fa fa-trash"></i> {{ text_token_remove }}</button>
                </div>
                <div class="mcp-note w" id="mcp-token-new" style="display:none;margin:8px 0 0">{{ text_token_copy_now }}</div>
                  {% if error_token %}<div class="mcp-err">{{ error_token }}</div>{% endif %}
                  </div>
            </div>
            <div class="mcp-field">
              <label for="input-url-secret">{{ entry_url_secret }}</label>
              <div>
                <div class="mcp-row mcp-keyrow">
                  <input type="password" name="module_mcp_server_url_secret" value="{{ module_mcp_server_url_secret|e }}" id="input-url-secret" class="form-control mono" autocomplete="new-password" data-saved="{{ module_mcp_server_url_secret|e('html_attr') }}" data-base="{{ secret_base|e('html_attr') }}"/>
                  <button type="button" class="mcp-btn" data-mcp-toggle="#input-url-secret" aria-label="{{ ui_show|e('html_attr') }}"><i class="fa fa-eye"></i></button>
                  <button type="button" class="mcp-btn" data-mcp-generate="#input-url-secret" data-mcp-length="20" data-mcp-prefix="key-"><i class="fa fa-refresh"></i> {{ text_generate }}</button>
                  <button type="button" class="mcp-btn" id="mcp-secret-copy"{% if not module_mcp_server_url_secret %} disabled{% endif %}><i class="fa fa-copy"></i> {{ ui_copy }}</button>
                  <button type="button" class="mcp-btn d" id="mcp-secret-clear"{% if not module_mcp_server_url_secret %} disabled{% endif %}><i class="fa fa-trash"></i> {{ text_token_remove }}</button>
                </div>
                <div class="mcp-note w" id="mcp-secret-note" style="display:none;margin:8px 0 0"><i class="fa fa-exclamation-triangle"></i><span>{{ ui_secret_new_note }}</span></div>
                  {% if error_url_secret %}<div class="mcp-err">{{ error_url_secret }}</div>{% endif %}
                  </div>
            </div>
              </div>
          </details>
        </section>

      </div>

      {# ================================================================ history #}
      <div class="mcp-pane" id="tab-history">
        <div class="mcp-subnav" id="hist-nav">
          <button type="button" data-hist="changes"{% if not free %} class="active"{% endif %}><i class="fa fa-undo"></i> {{ ui_hist_changes }}</button>
          <button type="button" data-hist="log"{% if free %} class="active"{% endif %}><i class="fa fa-list"></i> {{ ui_hist_log }}</button>
          <button type="button" data-hist="archives" id="hist-archives-btn" hidden><i class="fa fa-archive"></i> {{ ui_hist_archives }}</button>
        </div>
        <div class="mcp-hist{% if not free %} active{% endif %}" id="hist-changes">
          <p class="mcp-sub">{{ text_changes_intro }}</p>
          <div class="mcp-fbar" id="ch-filters">
            <div class="f chips"><span>{{ ui_ch_show }}</span><div class="mcp-chips" id="ch-state"><button type="button" data-state="open" class="on">{{ ui_ch_state_open }} <span class="n" data-n="open"></span></button><button type="button" data-state="done">{{ ui_ch_state_done }} <span class="n" data-n="done"></span></button><button type="button" data-state="all">{{ ui_ch_state_all }} <span class="n" data-n="total"></span></button></div></div>
            <label class="f no"><span>{{ ui_ch_no }}</span><input type="text" inputmode="numeric" class="form-control" id="ch-no" placeholder="{{ ui_ch_no_ph|e('html_attr') }}"/></label>
            <label class="f"><span>{{ ui_ch_connection }}</span><select id="ch-client" class="form-control"><option value="">{{ ui_ch_all_connections }}</option></select></label>
            <label class="f"><span>{{ ui_ch_period }}</span><select id="ch-period" class="form-control"><option value="">{{ ui_ch_all_time }}</option><option value="session">{{ ui_ch_session }}</option><option value="24h">{{ ui_ch_24h }}</option><option value="7d">{{ ui_ch_7d }}</option></select></label>
            <button type="button" class="mcp-btn ghost f-reset" id="ch-reset" style="display:none"><i class="fa fa-times"></i> {{ text_filter_reset }}</button>
            <span class="sp"></span>
            <button type="button" class="mcp-btn s ch-sel-page" id="ch-sel-page"><i class="fa fa-check"></i> {{ ui_ch_sel_page }}</button>
            <button type="button" class="mcp-btn s d" id="ch-rb-all" disabled><i class="fa fa-undo"></i> <span></span></button>
          </div>
          <div class="mcp-selbar" id="ch-selbar"><b id="ch-sel-n"></b><button type="button" class="mcp-btn s d" id="ch-rb-sel"><i class="fa fa-undo"></i> {{ ui_ch_rb_selected }}</button><button type="button" class="mcp-btn s ghost" id="ch-sel-clear">{{ ui_ch_sel_clear }}</button></div>
          <div class="mcp-tcard">
            <div class="mcp-scroll"><table class="mcp-table mcp-cards mcp-cht ch-fixed">
